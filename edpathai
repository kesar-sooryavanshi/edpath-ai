const API_KEY="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"; // 👈 Bas yahi change karo

// =========================================
// TYPES
// =========================================
type Role = "user" | "assistant";
interface Message { role: Role; content: string; }
interface Chat { id: string; title: string; messages: Message[]; }

// =========================================
// AI CALL
// =========================================
async function askAI(messages: Message[]): Promise<string> {
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "x-api-key": API_KEY,
      "anthropic-version": "2023-06-01",
    },
    body: JSON.stringify({
      model: "claude-sonnet-4-20250514",
      max_tokens: 1000,
      system: "You are EdPath AI, a smart and friendly study companion for students. Help with homework, explain concepts clearly with examples, use bullet points and bold for key terms. Be encouraging and concise.",
      messages: messages.map((m) => ({ role: m.role, content: m.content })),
    }),
  });
  const data = await res.json();
  return data?.content?.[0]?.text ?? "Sorry, no response.";
}

// =========================================
// TYPING DOTS
// =========================================
function TypingDots() {
  return (
    <div style={{ display: "flex", gap: 5, padding: "12px 16px", alignItems: "center" }}>
      {[0, 1, 2].map((i) => (
        <span key={i} style={{
          width: 8, height: 8, borderRadius: "50%",
          background: "#818cf8", display: "inline-block",
          animation: `bounce 1.2s infinite ${i * 0.2}s`,
        }} />
      ))}
    </div>
  );
}

// =========================================
// MESSAGE BUBBLE
// =========================================
function Bubble({ msg }: { msg: Message }) {
  const isUser = msg.role === "user";
  const html = msg.content
    .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
    .replace(/^[-*]\s(.+)/gm, "<span style='display:flex;gap:6px'><span style='color:#818cf8'>▸</span><span>$1</span></span>")
    .replace(/\n/g, "<br/>");

  return (
    <div style={{ display: "flex", justifyContent: isUser ? "flex-end" : "flex-start", alignItems: "flex-end", gap: 8, marginBottom: 14 }}>
      {!isUser && (
        <div style={{ width: 32, height: 32, borderRadius: "50%", background: "linear-gradient(135deg,#6366f1,#8b5cf6)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 15, flexShrink: 0 }}>🎓</div>
      )}
      <div style={{
        maxWidth: "70%", padding: "11px 15px",
        borderRadius: isUser ? "18px 18px 4px 18px" : "4px 18px 18px 18px",
        background: isUser ? "linear-gradient(135deg,#6366f1,#7c3aed)" : "rgba(255,255,255,0.07)",
        color: isUser ? "#fff" : "#e2e8f0",
        fontSize: "0.9rem", lineHeight: 1.6,
        border: isUser ? "none" : "1px solid rgba(255,255,255,0.09)",
        wordBreak: "break-word",
      }}
        dangerouslySetInnerHTML={isUser ? undefined : { __html: html }}
      >
        {isUser ? msg.content : undefined}
      </div>
      {isUser && (
        <div style={{ width: 32, height: 32, borderRadius: "50%", background: "linear-gradient(135deg,#f59e0b,#ef4444)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 15, flexShrink: 0 }}>👤</div>
      )}
    </div>
  );
}

// =========================================
// SIDEBAR
// =========================================
function Sidebar({ open, chats, activeId, onNew, onSelect, onDelete, onClose }: {
  open: boolean; chats: Chat[]; activeId: string;
  onNew: () => void; onSelect: (id: string) => void;
  onDelete: (id: string) => void; onClose: () => void;
}) {
  return (
    <>
      {open && <div onClick={onClose} style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.5)", zIndex: 40 }} />}
      <aside style={{
        position: "fixed", top: 0, left: 0, bottom: 0, width: 255,
        background: "rgba(13,13,23,0.97)", borderRight: "1px solid rgba(255,255,255,0.07)",
        display: "flex", flexDirection: "column", zIndex: 50,
        transform: open ? "translateX(0)" : "translateX(-100%)",
        transition: "transform 0.3s ease",
      }}>
        <div style={{ padding: "18px 14px", borderBottom: "1px solid rgba(255,255,255,0.06)", display: "flex", alignItems: "center", justifyContent: "space-between" }}>
          <div style={{ display: "flex", alignItems: "center", gap: 9 }}>
            <div style={{ width: 32, height: 32, borderRadius: 9, background: "linear-gradient(135deg,#6366f1,#8b5cf6)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 16 }}>🎓</div>
            <span style={{ fontWeight: 700, fontSize: "0.95rem", color: "#e2e8f0" }}>EdPath AI</span>
          </div>
          <button onClick={onClose} style={{ background: "none", border: "none", color: "#94a3b8", fontSize: 18, cursor: "pointer" }}>✕</button>
        </div>
        <div style={{ padding: "10px 12px" }}>
          <button onClick={onNew} style={{ width: "100%", padding: "9px 14px", background: "linear-gradient(135deg,#6366f1,#8b5cf6)", color: "#fff", border: "none", borderRadius: 10, cursor: "pointer", fontWeight: 600, fontSize: "0.85rem", display: "flex", alignItems: "center", gap: 7 }}>
            <span style={{ fontSize: 18 }}>+</span> New Chat
          </button>
        </div>
        <div style={{ flex: 1, overflowY: "auto", padding: "4px 10px" }}>
          {chats.length === 0 && <p style={{ fontSize: "0.78rem", color: "#475569", textAlign: "center", marginTop: 20 }}>No chats yet!</p>}
          {chats.map((c) => (
            <div key={c.id} onClick={() => { onSelect(c.id); onClose(); }} style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "9px 10px", borderRadius: 9, cursor: "pointer", marginBottom: 2, background: c.id === activeId ? "rgba(99,102,241,0.18)" : "transparent", border: c.id === activeId ? "1px solid rgba(99,102,241,0.3)" : "1px solid transparent" }}>
              <span style={{ fontSize: "0.8rem", color: c.id === activeId ? "#a5b4fc" : "#94a3b8", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", fontWeight: c.id === activeId ? 600 : 400 }}>💬 {c.title}</span>
              <button onClick={(e) => { e.stopPropagation(); onDelete(c.id); }} style={{ background: "none", border: "none", color: "#475569", cursor: "pointer", fontSize: 13 }}>🗑</button>
            </div>
          ))}
        </div>
        <div style={{ padding: "10px 14px", borderTop: "1px solid rgba(255,255,255,0.06)", fontSize: "0.7rem", color: "#475569", textAlign: "center" }}>EdPath AI v1.0 • Study Smarter</div>
      </aside>
    </>
  );
}

// =========================================
// MAIN APP
// =========================================
export default function App() {
  const [dark, setDark] = useState(false);
  const [sideOpen, setSideOpen] = useState(false);
  const [chats, setChats] = useState<Chat[]>([]);
  const [activeId, setActiveId] = useState("");
  const [loading, setLoading] = useState(false);
  const [input, setInput] = useState("");
  const bottomRef = useRef<HTMLDivElement>(null);
  const textRef = useRef<HTMLTextAreaElement>(null);

  const messages: Message[] = chats.find((c) => c.id === activeId)?.messages ?? [];

  useEffect(() => { bottomRef.current?.scrollIntoView({ behavior: "smooth" }); }, [messages, loading]);
  useEffect(() => { newChat(); }, []);

  function newChat() {
    const id = Date.now().toString();
    setChats((p) => [{ id, title: "New Chat", messages: [] }, ...p]);
    setActiveId(id);
    setSideOpen(false);
  }

  function deleteChat(id: string) {
    setChats((p) => {
      const f = p.filter((c) => c.id !== id);
      if (id === activeId) setActiveId(f[0]?.id ?? "");
      return f;
    });
  }

  async function send() {
    const text = input.trim();
    if (!text || loading) return;
    setInput("");
    if (textRef.current) textRef.current.style.height = "auto";
    const userMsg: Message = { role: "user", content: text };
    setChats((p) => p.map((c) => c.id !== activeId ? c : {
      ...c,
      messages: [...c.messages, userMsg],
      title: c.title === "New Chat" ? text.slice(0, 38) + (text.length > 38 ? "…" : "") : c.title,
    }));
    setLoading(true);
    try {
      const hist = chats.find((c) => c.id === activeId)?.messages ?? [];
      const reply = await askAI([...hist, userMsg]);
      setChats((p) => p.map((c) => c.id !== activeId ? c : { ...c, messages: [...c.messages, { role: "assistant", content: reply }] }));
    } catch {
      setChats((p) => p.map((c) => c.id !== activeId ? c : { ...c, messages: [...c.messages, { role: "assistant", content: "⚠️ Error. Check API key and try again." }] }));
    }
    setLoading(false);
  }

  const bg = dark
    ? "radial-gradient(ellipse at 20% 20%,rgba(99,102,241,.13) 0%,transparent 50%),#0a0a14"
    : "radial-gradient(ellipse at 20% 20%,rgba(99,102,241,.07) 0%,transparent 50%),#f8f9ff";

  const suggestions = [
    { icon: "📐", text: "Explain the quadratic formula" },
    { icon: "🧬", text: "How does DNA replication work?" },
    { icon: "📜", text: "Causes of World War I" },
    { icon: "⚗️", text: "Acids vs bases difference" },
    { icon: "📖", text: "Help me write a thesis statement" },
    { icon: "🔢", text: "Teach me derivatives step by step" },
  ];

  return (
    <div style={{ minHeight: "100vh", background: bg, color: dark ? "#e2e8f0" : "#1e293b", fontFamily: "'DM Sans',system-ui,sans-serif", display: "flex", flexDirection: "column" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');
        *{box-sizing:border-box;margin:0;padding:0}
        ::-webkit-scrollbar{width:4px}
        ::-webkit-scrollbar-thumb{background:rgba(99,102,241,.3);border-radius:10px}
        @keyframes bounce{0%,80%,100%{transform:translateY(0)}40%{transform:translateY(-7px)}}
        @keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
        @keyframes glow{0%,100%{box-shadow:0 8px 30px rgba(99,102,241,.5)}50%{box-shadow:0 8px 40px rgba(99,102,241,.75)}}
        textarea::placeholder{color:#475569}
      `}</style>

      <Sidebar open={sideOpen} chats={chats} activeId={activeId} onNew={newChat} onSelect={setActiveId} onDelete={deleteChat} onClose={() => setSideOpen(false)} />

      {/* Navbar */}
      <header style={{ height: 58, display: "flex", alignItems: "center", justifyContent: "space-between", padding: "0 18px", background: dark ? "rgba(10,10,20,.9)" : "rgba(255,255,255,.9)", backdropFilter: "blur(20px)", borderBottom: `1px solid ${dark ? "rgba(255,255,255,.06)" : "rgba(0,0,0,.06)"}`, position: "sticky", top: 0, zIndex: 30 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
          <button onClick={() => setSideOpen(true)} style={{ background: "none", border: "none", color: "#94a3b8", fontSize: 22, cursor: "pointer" }}>☰</button>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <div style={{ width: 30, height: 30, borderRadius: 8, background: "linear-gradient(135deg,#6366f1,#8b5cf6)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 15 }}>🎓</div>
            <span style={{ fontWeight: 800, fontSize: "1rem", background: "linear-gradient(135deg,#6366f1,#8b5cf6)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent" }}>EdPath AI</span>
          </div>
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <button onClick={() => setDark((d) => !d)} style={{ width: 36, height: 36, borderRadius: 9, border: "none", background: dark ? "rgba(255,255,255,.08)" : "rgba(0,0,0,.06)", cursor: "pointer", fontSize: 17 }}>{dark ? "☀️" : "🌙"}</button>
          <div style={{ width: 34, height: 34, borderRadius: "50%", background: "linear-gradient(135deg,#f59e0b,#ef4444)", display: "flex", alignItems: "center", justifyContent: "center", color: "#fff", fontWeight: 700, fontSize: "0.85rem" }}>S</div>
        </div>
      </header>

      {/* Chat */}
      <main style={{ flex: 1, overflowY: "auto", display: "flex", flexDirection: "column" }}>
        {messages.length === 0 ? (
          <div style={{ flex: 1, display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", padding: "40px 20px", textAlign: "center" }}>
            <div style={{ width: 84, height: 84, borderRadius: 26, background: "linear-gradient(135deg,#6366f1,#8b5cf6)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 40, marginBottom: 22, animation: "glow 3s ease-in-out infinite" }}>🎓</div>
            <h1 style={{ fontSize: "clamp(1.8rem,5vw,2.6rem)", fontWeight: 800, letterSpacing: "-1px", background: "linear-gradient(135deg,#6366f1,#a78bfa)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", marginBottom: 10 }}>EdPath AI</h1>
            <p style={{ color: dark ? "#94a3b8" : "#64748b", fontSize: "1rem", marginBottom: 6 }}>Your Smart Study Companion</p>
            <p style={{ color: dark ? "#475569" : "#94a3b8", fontSize: "0.85rem", marginBottom: 36, maxWidth: 380 }}>Ask anything — calculus, chemistry, essays, history ✨</p>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit,minmax(190px,1fr))", gap: 9, width: "100%", maxWidth: 640 }}>
              {suggestions.map((s, i) => (
                <button key={i} onClick={() => setInput(s.text)} style={{ padding: "11px 13px", background: dark ? "rgba(255,255,255,.04)" : "rgba(99,102,241,.06)", border: `1px solid ${dark ? "rgba(255,255,255,.08)" : "rgba(99,102,241,.15)"}`, borderRadius: 13, cursor: "pointer", display: "flex", alignItems: "center", gap: 9, textAlign: "left", color: dark ? "#cbd5e1" : "#374151", fontSize: "0.8rem", fontWeight: 500, animation: `fadeUp .4s ease ${i * 0.07}s both` }}>
                  <span style={{ fontSize: 20 }}>{s.icon}</span>{s.text}
                </button>
              ))}
            </div>
          </div>
        ) : (
          <div style={{ maxWidth: 700, margin: "0 auto", width: "100%", padding: "22px 16px 12px" }}>
            {messages.map((m, i) => <Bubble key={i} msg={m} />)}
            {loading && (
              <div style={{ display: "flex", alignItems: "flex-end", gap: 8, marginBottom: 14 }}>
                <div style={{ width: 32, height: 32, borderRadius: "50%", background: "linear-gradient(135deg,#6366f1,#8b5cf6)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 15, flexShrink: 0 }}>🎓</div>
                <div style={{ background: "rgba(255,255,255,.07)", border: "1px solid rgba(255,255,255,.09)", borderRadius: "4px 18px 18px 18px" }}><TypingDots /></div>
              </div>
            )}
            <div ref={bottomRef} />
          </div>
        )}
      </main>

      {/* Input */}
      <div style={{ padding: "14px 18px 18px", background: dark ? "rgba(10,10,20,.9)" : "rgba(255,255,255,.9)", backdropFilter: "blur(20px)", borderTop: `1px solid ${dark ? "rgba(255,255,255,.06)" : "rgba(0,0,0,.06)"}` }}>
        <div style={{ maxWidth: 700, margin: "0 auto" }}>
          <div style={{ display: "flex", alignItems: "flex-end", gap: 9, background: dark ? "rgba(255,255,255,.06)" : "rgba(0,0,0,.04)", border: `1.5px solid ${dark ? "rgba(255,255,255,.1)" : "rgba(0,0,0,.1)"}`, borderRadius: 17, padding: "9px 13px" }}>
            <button style={{ background: "none", border: "none", fontSize: 19, color: "#475569", cursor: "not-allowed", opacity: 0.5, flexShrink: 0 }}>🎤</button>
            <textarea
              ref={textRef} value={input}
              onChange={(e) => { setInput(e.target.value); e.target.style.height = "auto"; e.target.style.height = Math.min(e.target.scrollHeight, 140) + "px"; }}
              onKeyDown={(e) => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); void send(); } }}
              placeholder="Ask me anything about your studies..."
              rows={1} disabled={loading}
              style={{ flex: 1, background: "none", border: "none", outline: "none", resize: "none", fontSize: "0.92rem", lineHeight: 1.6, color: dark ? "#e2e8f0" : "#1e293b", fontFamily: "inherit", minHeight: 27, maxHeight: 140, overflowY: "hidden" }}
            />
            <button onClick={() => void send()} disabled={!input.trim() || loading} style={{ width: 36, height: 36, borderRadius: 10, border: "none", background: input.trim() && !loading ? "linear-gradient(135deg,#6366f1,#8b5cf6)" : "rgba(255,255,255,.08)", color: input.trim() && !loading ? "#fff" : "#4b5563", fontSize: 15, cursor: input.trim() && !loading ? "pointer" : "not-allowed", flexShrink: 0, display: "flex", alignItems: "center", justifyContent: "center" }}>➤</button>
          </div>
          <p style={{ fontSize: "0.7rem", color: "#475569", textAlign: "center", marginTop: 7 }}>Enter to send • Shift+Enter for new line</p>
        </div>
      </div>
    </div>
  );
}
